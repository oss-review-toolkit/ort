{
    "name": "ort-web-app-reporter",
    "description": "Single page webapp to visualize scan reports generated by OSS Review Toolkit.",
    "version": "0.4.0",
    "license": "Apache-2.0",
    "private": true,
    "author": {
        "name": "The ORT Project Authors",
        "url": "https://oss-review-toolkit.org/"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/oss-review-toolkit/ort.git",
        "directory": "plugins/reporters/web-app-template"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsgo --noEmit -p tsconfig.json || tsc --noEmit -p tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "biome check .",
        "lint:fix": "biome lint --write --unsafe --only=nursery/useSortedClasses . && biome check --write .",
        "format": "biome format --write .",
        "import-ort-file": "node scripts/import-ort-file.mjs"
    },
    "dependencies": {
        "@tanstack/match-sorter-utils": "^8.19.4",
        "@tanstack/react-table": "^8.21.3",
        "ae-cvss-calculator": "^1.0.13",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "lucide-react": "^1.46.0",
        "markdown-to-jsx": "^9.10.2",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.6.7",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-syntax-highlighter": "^16.1.1",
        "recharts": "3.10.1",
        "tailwind-merge": "^3.7.0",
        "tw-animate-css": "^1.4.0",
        "yaml": "^2.9.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.13",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^26.6.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "@vitejs/plugin-react": "^6.1.1",
        "jsdom": "^30.0.1",
        "rollup": "^4.63.3",
        "rollup-plugin-copy": "^3.5.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "vite-plugin-singlefile": "^2.3.3",
        "vitest": "^5.0.1"
    },
    "production": [
        ">0.2%",
        "not dead",
        "not op_mini all"
    ],
    "development": [
        "last 1 chrome version",
        "last 1 firefox version",
        "last 1 safari version"
    ]
}
