{
    "name": "ort-web-app-reporter",
    "description": "Single page webapp to visualize scan reports generated by OSS Review Toolkit.",
    "version": "0.4.0",
    "license": "Apache-2.0",
    "private": true,
    "author": {
        "name": "The ORT Project Authors",
        "url": "https://oss-review-toolkit.org/"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/oss-review-toolkit/ort.git",
        "directory": "plugins/reporters/web-app-tanstack-template"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "format": "biome format --write .",
        "import-ort-file": "node scripts/import-ort-file.mjs",
        "lint": "biome check .",
        "lint:fix": "biome lint --write --unsafe --only=nursery/useSortedClasses . && biome check --write .",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsgo --noEmit -p tsconfig.json || tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@tanstack/match-sorter-utils": "^8.19.4",
        "@tanstack/react-table": "^8.21.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "lucide-react": "^0.475.0",
        "markdown-to-jsx": "^9.5.0",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.6.0",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "react-syntax-highlighter": "^16.1.0",
        "recharts": "3.6.0",
        "tailwind-merge": "^3.0.1",
        "tw-animate-css": "^1.2.0",
        "yaml": "^2.8.2"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.2.5",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.0.7",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^22.13.4",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@typescript/native-preview": "latest",
        "@vitejs/plugin-react": "^5.1.2",
        "jsdom": "^29.1.1",
        "rollup": "^4.54.0",
        "rollup-plugin-copy": "^3.5.0",
        "tailwindcss": "^4.0.7",
        "typescript": "^5.7.3",
        "vite": "^7.3.0",
        "vite-plugin-singlefile": "^2.3.0",
        "vitest": "^3.2.7"
    },
    "production": [
        ">0.2%",
        "not dead",
        "not op_mini all"
    ],
    "development": [
        "last 1 chrome version",
        "last 1 firefox version",
        "last 1 safari version"
    ]
}
